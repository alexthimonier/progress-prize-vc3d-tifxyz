+void nativeSurfaceExport(const std::filesystem::path& root)
+{
+    OpenOptions options; options.author = "test";
+    auto store = ObjectStore::create(root / "native-surface.vcobj", options);
+    const Json coordinates{{"volume_uuid", "test-volume"}, {"scale_factor", 1}};
+    const vc::geometry::Surface surface{2, 2, {0.05f, 0.05f},
+        {{1, 2, 3}, {21, 2, 3}, {1, 22, 3}, {21, 22, 3}}};
+    std::string uuid;
+    {
+        auto write = store.write();
+        ObjectRecord record;
+        record.kind = "surface";
+        record.meta = Json{{"source", "vc_grow_seg_from_seed"}, {"coordinates", coordinates}}.dump();
+        uuid = store.upsertObject(write, record);
+        store.putGeometry(write, uuid, vc::geometry::encode(surface));
+        write.commit();
+    }
+    const auto output = root / "native-surface";
+    exportGeometry(store, uuid, output);
+    std::ifstream file(output / "meta.json");
+    const auto metadata = Json::parse(file);
+    require(metadata.at("source") == "vc_grow_seg_from_seed", "export preserves the native source label");
+    require(metadata.at("coordinates") == coordinates, "export preserves the declared volume and scale");
+    auto reimported = ObjectStore::create(root / "native-surface-round-trip.vcobj", options);
+    const auto report = ingestGeometrySource(reimported, "surface", output);
+    require(report.ingested == 1 && report.problems.empty(), "native surface export reimports");
+    auto originalRead = store.read();
+    auto importedRead = reimported.read();
+    const auto original = store.currentGeometry(originalRead, uuid);
+    const auto imported = reimported.currentGeometry(importedRead, uuid);
+    require(original && imported, "both surface geometries exist");
+    require(store.readGeometryArray(originalRead, original->uuid, "points") ==
+            reimported.readGeometryArray(importedRead, imported->uuid, "points"),
+            "native surface export round-trips exact coordinates");
+}
+#endif
